{
  "name": "packspace-s3-sync",
  "productName": "PackSpace S3 Sync",
  "version": "1.0.0",
  "description": "Synchronise automatiquement (multi-thread) les fichiers d'impression Packspace depuis S3 vers un dossier local.",
  "main": "src/main.js",
  "author": {
    "name": "Packspace",
    "email": "contact@packspace.ma"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/store.js && node --check src/api.js && node --check src/engine.js && node --check src/syncManager.js && node --check src/service.js && node --check src/controlServer.js && node --check src/controlClient.js && node --check src/serviceInstaller.js && node --check src/uninstallHook.js && node --check src/updateUtils.js && node --check src/selfUpdater.js && node --check src/workers/downloadWorker.js && node --check renderer/renderer.js && node --check renderer/web-agent.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "service:dev": "node src/service.js",
    "docker:build": "docker build -t packspace-s3-sync ."
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "axios": "^1.7.7",
    "conf": "^10.2.0"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ma.packspace.s3sync",
    "productName": "PackSpace S3 Sync",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "PackSpace-S3-Sync-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "PackSpace-S3-Sync-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "PackSpace-S3-Sync-${version}-linux-${arch}.${ext}",
      "maintainer": "Packspace <contact@packspace.ma>",
      "desktop": {
        "entry": {
          "Name": "PackSpace S3 Sync",
          "StartupWMClass": "packspace-s3-sync"
        }
      },
      "synopsis": "Synchronisation des fichiers d'impression Packspace"
    },
    "artifactName": "PackSpace-S3-Sync-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "asar": false,
    "deb": {
      "fpm": [
        "--before-remove=build/deb/prerm"
      ]
    }
  },
  "optionalDependencies": {
    "node-windows": "1.0.0-beta.8"
  }
}
