{
  "name": "packspace-s3-sync",
  "productName": "PackSpace S3 Sync",
  "version": "1.0.0",
  "description": "Synchronise automatiquement (multi-thread) les fichiers d'impression Packspace depuis S3 vers un dossier local.",
  "main": "src/main.js",
  "author": "Packspace",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/store.js && node --check src/api.js && node --check src/syncManager.js && node --check src/workers/downloadWorker.js && node --check renderer/renderer.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "axios": "^1.7.7",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ma.packspace.s3sync",
    "productName": "PackSpace S3 Sync",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "PackSpace-S3-Sync-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "PackSpace-S3-Sync-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "PackSpace-S3-Sync-${version}-linux-${arch}.${ext}"
    },
    "artifactName": "PackSpace-S3-Sync-${version}-${os}-${arch}.${ext}",
    "publish": null
  }
}
